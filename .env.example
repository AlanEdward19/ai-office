# Personal API key from Linear → Settings → Security & access.
# Sent as the Authorization value with no Bearer prefix.
# Leave this empty in git. Put the real key only in .env.local.
LINEAR_API_KEY=

# User API key from Cursor Dashboard → API Keys.
# Read, and used to start a cloud agent, only while a browser tab of this app is open.
# Leave this empty in git. Put the real key only in .env.local.
CURSOR_API_KEY=
